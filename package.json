{
  "name": "my-finance-record",
  "version": "2.5.0",
  "private": true,
  "description": "Talaan local-first profile-based personal and household finance PWA with encrypted Supabase synchronization.",
  "type": "module",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "predev": "npm run prepare:runtime",
    "dev": "node server.js",
    "prestart": "npm run prepare:runtime",
    "start": "node server.js",
    "build": "echo 'No build step required'",
    "lint": "eslint .",
    "inspect": "node tests/helpers/inspect-project.mjs",
    "pretest": "npm run prepare:runtime",
    "test": "node tests/run.mjs",
    "pretest:finance": "npm run prepare:runtime",
    "test:finance": "node tests/run.mjs finance",
    "pretest:regression": "npm run prepare:runtime",
    "test:regression": "node tests/run.mjs regression",
    "pretest:sync": "npm run prepare:runtime",
    "test:sync": "node tests/run.mjs sync",
    "pretest:browser": "npm run prepare:runtime",
    "test:browser": "playwright test",
    "maintainability": "node tests/helpers/check-maintainability.mjs",
    "audit": "npm audit --omit=dev",
    "quality": "npm run prepare:runtime && npm run inspect && npm run lint && npm run maintainability && npm run test",
    "quality:ci": "npm run quality && npm run test:browser && npm run audit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0"
  }
}
